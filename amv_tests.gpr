--  The tests compile the library sources directly (instead of with-ing
--  amv.gpr) so that building one test main only compiles its closure. That
--  lets one area of the library be built and tested while another area is
--  still being edited.

project AMV_Tests is
   for Source_Dirs use ("src", "tests", "tests/real_images");
   for Object_Dir use "build/test-obj";
   for Exec_Dir use "build/bin";
   for Main use ("test_suite.adb", "test_real_images.adb");
   for Languages use ("Ada");

   package Builder is
      for Global_Configuration_Pragmas use "tests/initialize_scalars.adc";
   end Builder;

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatW8", "-gnata", "-gnatwa", "-gnatVa", "-g", "-O1");
   end Compiler;

   package Binder is
      for Default_Switches ("Ada") use ("-Es");
   end Binder;
end AMV_Tests;
