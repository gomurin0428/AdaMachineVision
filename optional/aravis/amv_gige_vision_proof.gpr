with "../../amv.gpr";

project AMV_GigE_Vision_Proof is
   for Source_Dirs use ("src");
   for Object_Dir use "../../build/aravis-proof-obj";
   for Languages use ("Ada");

   package Compiler is
      for Local_Configuration_Pragmas use "../../contracts.adc";
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatW8", "-ffp-contract=off",
         "-gnatwa", "-gnatVa", "-O2", "-gnatn");
   end Compiler;

   package Prove is
      for Proof_Switches ("Ada") use ("--level=2", "--timeout=30");
   end Prove;
end AMV_GigE_Vision_Proof;
