with "../../amv.gpr";

library project AMV_GigE_Vision is
   for Source_Dirs use ("src");
   for Object_Dir use "../../build/aravis-obj";
   for Library_Dir use "../../build/aravis-lib";
   for Library_Name use "amv_gige_vision";
   for Library_Kind use "static";
   for Languages use ("Ada", "C");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatW8", "-ffp-contract=off",
         "-gnatwa", "-gnatVa", "-gnatwe", "-O2");
      for Default_Switches ("C") use
        ("-std=c11", "-Wall", "-Wextra", "-Werror", "-O2");
   end Compiler;
end AMV_GigE_Vision;
