with "../../../amv.gpr";

library project AMV_GigE_Vision_Test_Library is
   for Source_Dirs use ("../src");
   for Object_Dir use "../../../build/aravis-test-lib-obj";
   for Library_Dir use "../../../build/aravis-test-lib";
   for Library_Name use "amv_gige_vision_test";
   for Library_Kind use "static";
   for Languages use ("Ada", "C");

   package Compiler is
      for Local_Configuration_Pragmas use "../../../contracts.adc";
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatW8", "-ffp-contract=off",
         "-gnatwa", "-gnatVa", "-gnatwe", "-O2");
      for Default_Switches ("C") use
        ("-std=c11", "-Wall", "-Wextra", "-Werror", "-O2",
         "-DAMV_ARAVIS_TESTING");
   end Compiler;
end AMV_GigE_Vision_Test_Library;
