with "../amv_flow.gpr";

--  The AMV Flow engine as a shared library (amvflow) with the C API of
--  ../include/amv_flow.h. Encapsulated: AMV, the engine and the GNAT
--  runtime are inside, and loading the library initialises them.
library project AMV_Flow_C is
   for Source_Dirs use ("src", "no_camera");
   for Object_Dir use "../../../build/flow-c-obj";
   for Library_Dir use "../../../build/flow-c-lib";
   for Library_Name use "amvflow";
   for Library_Kind use "dynamic";
   for Library_Standalone use "encapsulated";
   for Library_Interface use ("AMV.Flow.C_API");
   for Library_Auto_Init use "true";
   for Languages use ("Ada");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatW8", "-ffp-contract=off",
         "-gnatwa", "-gnatVa", "-gnatwe", "-O2");
   end Compiler;
end AMV_Flow_C;
