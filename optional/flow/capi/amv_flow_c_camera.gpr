with "../camera/amv_flow_camera.gpr";

--  amvflow with the Camera node (AMV.Flow.Nodes.Camera): the same C API
--  as amv_flow_c.gpr, built into build/flow-c-camera-lib. Needs Aravis:
--  ARAVIS_LIBS holds the linker options (as pkg-config --libs gives them),
--  and the Aravis and GLib libraries must be found when amvflow loads.
library project AMV_Flow_C_Camera is
   for Source_Dirs use ("src", "camera");
   for Object_Dir use "../../../build/flow-c-camera-obj";
   for Library_Dir use "../../../build/flow-c-camera-lib";
   for Library_Name use "amvflow";
   for Library_Kind use "dynamic";
   for Library_Standalone use "encapsulated";
   for Library_Interface use ("AMV.Flow.C_API");
   for Library_Auto_Init use "true";
   for Library_Options use external_as_list ("ARAVIS_LIBS", " ");
   for Languages use ("Ada");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatW8", "-ffp-contract=off",
         "-gnatwa", "-gnatVa", "-gnatwe", "-O2");
   end Compiler;
end AMV_Flow_C_Camera;
