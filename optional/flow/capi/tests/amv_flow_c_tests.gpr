with "../amv_flow_c.gpr";

project AMV_Flow_C_Tests is
   for Source_Dirs use (".", "../../include");
   for Object_Dir use "../../../../build/flow-c-tests-obj";
   for Exec_Dir use "../../../../build/bin";
   for Main use ("test_amvf.c");
   for Languages use ("C");

   package Compiler is
      for Default_Switches ("C") use
        ("-std=c11", "-Wall", "-Wextra", "-Werror", "-O1");
   end Compiler;
end AMV_Flow_C_Tests;
