with "../amv_flow.gpr";

project AMV_Flow_CLI is
   for Source_Dirs use (".");
   for Object_Dir use "../../../build/flow-cli-obj";
   for Exec_Dir use "../../../build/bin";
   for Main use ("amv_flow.adb");
   for Languages use ("Ada");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatW8", "-ffp-contract=off",
         "-gnatwa", "-gnatVa", "-gnatwe", "-O2");
   end Compiler;
end AMV_Flow_CLI;
