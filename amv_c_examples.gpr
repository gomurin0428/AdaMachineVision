--  The C examples (examples/c): C mains that include include/amv.h and
--  call the C API. The library sources are compiled directly, with the
--  library's switches, as in amv_c_tests.gpr.

project AMV_C_Examples is
   for Languages use ("Ada", "C");
   for Source_Dirs use ("src", "include", "examples/c");
   for Object_Dir use "build/c-example-obj";
   for Exec_Dir use "build/bin";
   for Main use ("c_blob_inspection.c");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatW8", "-gnatwa", "-gnatVa", "-O2", "-gnatn");
      for Default_Switches ("C") use
        ("-std=c11", "-Wall", "-Wextra", "-Wpedantic", "-O2");
   end Compiler;
end AMV_C_Examples;
