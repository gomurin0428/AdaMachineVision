--  The C API tests: a C main (tests/c) that includes include/amv.h and
--  calls the kernels' entry points. The library sources are compiled
--  directly, with the library's switches, as in amv_tests.gpr.

project AMV_C_Tests is
   for Languages use ("Ada", "C");
   for Source_Dirs use ("src", "include", "tests/c");
   for Object_Dir use "build/c-test-obj";
   for Exec_Dir use "build/bin";
   for Main use ("test_c_api.c");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatW8", "-gnatwa", "-gnatVa", "-O2", "-gnatn");
      for Default_Switches ("C") use
        ("-std=c11", "-Wall", "-Wextra", "-Wpedantic", "-O2");
   end Compiler;
end AMV_C_Tests;
